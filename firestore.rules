rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users and App Accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Master Vessels
    match /vessels/{vesselId} {
      allow read, write: if true;
    }

    // Master Ports
    match /ports/{portId} {
      allow read, write: if true;
    }

    // Master Clients
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Master Routes
    match /routes/{routeId} {
      allow read, write: if true;
    }

    // Shipments (Bill of Lading & Bookings)
    match /shipments/{shipmentId} {
      allow read, write: if true;
    }

    // Tracking Logs
    match /tracking_logs/{logId} {
      allow read, write: if true;
    }

    // Operational Expenses
    match /operational_expenses/{expenseId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
